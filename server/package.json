{
  "name": "@edulearn/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "esbuild src/index.ts src/db/cli.ts --bundle --platform=node --format=esm --packages=external --outdir=dist --target=node20",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "db:migrate": "tsx --env-file-if-exists=../.env src/db/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=../.env src/db/cli.ts setup",
    "db:reset": "tsx --env-file-if-exists=../.env src/db/cli.ts reset",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:setup": "tsx --env-file-if-exists=../.env src/db/cli.ts setup",
    "db:sample": "tsx --env-file-if-exists=../.env src/db/cli.ts sample",
    "db:deactivate-demo": "tsx --env-file-if-exists=../.env src/db/cli.ts deactivate-demo"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.10",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}
