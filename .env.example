# Copy to .env and adjust. The server reads this file automatically.
DATABASE_URL=postgres://edulearn:edulearn@localhost:5432/edulearn
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PORT=4000
# Optional: only used to pre-fill school settings on first start (change them later in the app)
SCHOOL_NAME=
CURRENCY=TZS
SESSION_DAYS=7
# Public address of the app (used in password-reset emails)
APP_URL=http://localhost:5173
# Optional SMTP for password-reset emails. Without it, reset requests notify the school office instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
